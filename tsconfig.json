{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"], "noEmit": true
  },
  "include": ["apps", "packages", "services", "tests", "vite.config.ts"]
}
